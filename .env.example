#Networking / connection settings
APP_IP=localhost
APP_PORT=3000
COOKIE_TARGET_DOMAIN=localhost # in production the parent domain (example.com, not api.example.com), so the cookie also reaches cdn.example.com
DB_CONNECTION_STRING=mongodb://apiUser:AppPassword456!@192.168.x.x:27017/vb2007hu-api?authSource=vb2007hu-api

CORS_ORIGIN_URLS=http://localhost:5173,https://api.example.com

#Cryptography secret
CRYPTO_SECRET_KEY=verySecret_@nd_comp1ex_K€y

#Application settings
BASE_SITE_URL=https://vb2007.hu
CDN_URL=https://cdn.vb2007.hu # cdn origin without a path, uploads are served at <CDN_URL>/useruploads/<userId>/<uploadId><ext>
UPLOAD_DISK_DIRECTORY=/tmp/uploads # absolute path, relative paths resolve from the working directory
UPLOAD_MAX_FILESIZE=10 # in MB, defaults to 100 if missing or not a positive integer
UPLOAD_USER_QUOTA_MB=10240 # storage quota per user in MB, defaults to 10240 if missing or not a positive integer
SUPERUSER_EMAIL=admin@example.com # e-mail of the superuser (not the username, since usernames can change), empty means no superuser

#GitHub login (optional, see docs/github-oauth-setup.md)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

#E-mail (optional, see docs/email-setup.md): without SMTP_HOST and MAIL_FROM no mail is sent, and outside production it's printed instead
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587 # 587 uses STARTTLS, 465 implicit TLS
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="vb2007.hu <noreply@vb2007.hu>"

#Unit tests (see docs/dev-setup.md): for yarn test, SUPERUSER_EMAIL above must be a *.vb2007.test address, e.g. superuser@local.vb2007.test
TEST_RUN_ID= # optional, tags the run's test data; a random one is used when empty

#Docker (compose.yaml)
UPLOADS_DIR=./uploads # host folder mounted as the upload directory, writable by uid 1000 (production: /mnt/raid1/cdn/useruploads)
TUNNEL_TOKEN= # Cloudflare Tunnel token (Zero Trust > Networks > Tunnels)
