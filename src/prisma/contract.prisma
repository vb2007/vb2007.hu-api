// use prisma-8

type EmailCode {
  hash      String
  sentAt    Date
  expiresAt Date
  attempts  Int32?
}

type EmailChange {
  hash      String
  sentAt    Date
  expiresAt Date
  attempts  Int32?
  email     String
}

type CodeFailures {
  count Int32
  since Date
}

type ExpiringHash {
  hash      String
  expiresAt Date
}

type MfaChallengeGithub {
  id    String?
  login String?
}

type MfaChallengeEmail {
  hash     String?
  linkHash String?
}

type MfaChallenge {
  hash      String
  expiresAt Date
  attempts  Int32?
  github    MfaChallengeGithub?
  email     MfaChallengeEmail?
}

type MfaTotpSetup {
  secret    String
  session   String
  expiresAt Date
  attempts  Int32?
}

type Passkey {
  credentialId String
  publicKey    String
  counter      Double
  transports   String[]?
  name         String
  createdAt    Date
  lastUsedAt   Date?
}

type ApiKey {
  id         String
  name       String
  hash       String
  hint       String
  scopes     String[]
  createdAt  Date
  expiresAt  Date?
  lastUsedAt Date?
}

type UserAuthentication {
  password              String?
  salt                  String?
  sessionToken          String?
  sessionExpiresAt      Date?
  githubVerifiedAt      Date?
  emailVerifiedAt       Date?
  passwordReset         EmailCode?
  passwordResetFailures CodeFailures?
  emailChange           EmailChange?
  emailChangeFailures   CodeFailures?
  emailChangeSends      CodeFailures?
  passwordResetLinks    ExpiringHash[]?
  githubLink            ExpiringHash?
  mfaEmail              Bool?
  mfaEmailSentAt        Date?
  mfaEmailSends         CodeFailures?
  mfaChallenge          MfaChallenge?
  mfaFailures           CodeFailures?
  mfaTotpSecret         String?
  mfaTotpLastStep       Double?
  mfaTotpSetup          MfaTotpSetup?
  passkeys              Passkey[]?
  apiKeys               ApiKey[]?
  mfaRecoveryCodes      String[]?
  securityNotices       CodeFailures?
}

model User {
  id               ObjectId            @id @map("_id")
  username         String
  email            String
  authentication   UserAuthentication?
  githubId         String?
  githubLogin      String?
  uploadQuotaBytes Double?
  suspendedAt      Date?
  createdAt        Date?
  pastes           Pastebin[]
  shortUrls        ShortUrl[]
  uploads          UserUpload[]
  @@map("users")
  @@unique([email], map: "email_1")
  @@unique([githubId], map: "githubId_1", sparse: true)
  @@unique([username], map: "username_1", collationLocale: "en", collationStrength: 2)
}

model Pastebin {
  id       ObjectId @id @map("_id")
  content  String
  language String?
  addedBy  ObjectId
  owner    User     @relation(fields: [addedBy], references: [id])
  addedOn  Date
  @@map("pastebins")
  @@index([addedBy, sort(addedOn, Desc), sort(id, Desc)], map: "addedBy_1_addedOn_-1__id_-1")
  @@index([sort(addedOn, Desc), sort(id, Desc)], map: "addedOn_-1__id_-1")
}

model ShortUrl {
  id           ObjectId @id @map("_id")
  originalUrl  String
  shortenedUrl String
  addedBy      ObjectId
  owner        User     @relation(fields: [addedBy], references: [id])
  addedOn      Date?
  @@map("shorturls")
  @@unique([shortenedUrl], map: "shortenedUrl_1")
  @@unique([originalUrl, addedBy], map: "originalUrl_1_addedBy_1")
  @@index([addedBy, sort(addedOn, Desc), sort(id, Desc)], map: "addedBy_1_addedOn_-1__id_-1")
  @@index([sort(addedOn, Desc), sort(id, Desc)], map: "addedOn_-1__id_-1")
}

model UserUpload {
  id               ObjectId @id @map("_id")
  originalFileName String
  storedFileName   String
  filePath         String
  extension        String
  fileSize         Double
  mimeType         String
  uploadedBy       ObjectId
  owner            User     @relation(fields: [uploadedBy], references: [id])
  visibility       String?
  uploadedOn       Date?
  updatedOn        Date?
  @@map("useruploads")
  @@index([visibility], map: "visibility_1")
  @@index([uploadedBy, sort(uploadedOn, Desc), sort(id, Desc)], map: "uploadedBy_1_uploadedOn_-1__id_-1")
  @@index([sort(uploadedOn, Desc), sort(id, Desc)], map: "uploadedOn_-1__id_-1")
}

model PendingRegistration {
  id        ObjectId      @id @map("_id")
  email     String
  code      EmailCode
  failures  CodeFailures?
  expiresAt Date
  @@map("pendingregistrations")
  @@unique([email], map: "email_1")
  @@index([expiresAt], map: "expiresAt_1", expireAfterSeconds: 0)
}

model PasskeyChallenge {
  id        String    @id @map("_id")
  challenge String
  userId    ObjectId?
  expiresAt Date
  @@map("passkeychallenges")
  @@index([expiresAt], map: "expiresAt_1", expireAfterSeconds: 0)
}

model Migration {
  id        ObjectId @id @map("_id")
  name      String
  appliedOn Date
  @@map("migrations")
  @@unique([name], map: "name_1")
}
